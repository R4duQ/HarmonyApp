  "components": [
    {
      "name": "Tonal Circle Button",
      "kind": "button",
      "refersTo": "player-circle-button",
      "description": "Every secondary control on Now Playing.",
      "html": "<button class=\"ds-pcircle\" aria-label=\"Previous\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M6 6h2v12H6zm3.5 6 8.5 6V6z\"/></svg></button>",
      "css": ".ds-pcircle{width:46px;height:46px;border-radius:50%;background:#E8E4FD;color:#17142B;border:1px solid rgba(23,20,43,.08);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s}.ds-pcircle:hover{background:#DFDAFB}.ds-pcircle:focus-visible{outline:2px solid #6C4BE8;outline-offset:2px}.ds-pcircle:active{transform:scale(.96)}"
    },
    {
      "name": "Play Button",
      "kind": "button",
      "refersTo": "player-play-button",
      "description": "The one raised control on Now Playing.",
      "html": "<button class=\"ds-pplay\" aria-label=\"Pause\"><svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M6 19h4V5H6zm8-14v14h4V5z\"/></svg></button>",
      "css": ".ds-pplay{width:72px;height:72px;border-radius:50%;background:#FFFFFF;color:#17142B;border:1px solid rgba(23,20,43,.08);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .16s}.ds-pplay:hover{transform:scale(1.03)}.ds-pplay:focus-visible{outline:2px solid #6C4BE8;outline-offset:3px}"
    },
    {
      "name": "Lossless Badge",
      "kind": "chip",
      "refersTo": "lossless-badge",
      "description": "Shown before the audio summary when the file is lossless.",
      "html": "<span class=\"ds-lossless\">LOSSLESS</span><span class=\"ds-qsum\">FLAC · 1411 kbps · 96 kHz</span>",
      "css": ".ds-lossless{display:inline-block;padding:3px 7px;border-radius:999px;background:rgba(108,75,232,.13);border:1px solid rgba(108,75,232,.36);color:#6C4BE8;font:700 8px Roboto,sans-serif;letter-spacing:.45px}.ds-qsum{margin-left:8px;color:#5D5878;font:600 11px Roboto,sans-serif}"
    },
    {
      "name": "Vinyl Hero",
      "kind": "custom",
      "refersTo": "player-field-light",
      "description": "Sleeve at 70% width with the record the same size peeking right, turning every 9 s.",
      "html": "<div class=\"ds-vinyl\"><div class=\"ds-rec\"><i></i></div><div class=\"ds-sleeve\"></div></div>",
      "css": ".ds-vinyl{position:relative;width:280px;height:202px;background:#DCD7FA;padding:0}.ds-sleeve{position:absolute;left:0;top:3px;width:196px;height:196px;border-radius:12px;background:linear-gradient(135deg,#E07A2E,#7A3B12);box-shadow:0 14px 30px rgba(42,35,80,.35)}.ds-rec{position:absolute;right:0;top:3px;width:196px;height:196px;border-radius:50%;background:repeating-radial-gradient(circle,#17151C 0 3px,#2a2730 3px 4px);animation:ds-spin 9s linear infinite}.ds-rec i{position:absolute;left:50%;top:50%;width:66px;height:66px;margin:-33px;border-radius:50%;background:#B85A1E}.ds-rec i:after{content:\"\";position:absolute;left:50%;top:50%;width:9px;height:9px;margin:-4.5px;border-radius:50%;background:#DCD7FA}@keyframes ds-spin{to{transform:rotate(360deg)}}@media (prefers-reduced-motion:reduce){.ds-rec{animation:none}}"
    },
    {
      "name": "Mini Player Card",
      "kind": "card",
      "refersTo": "mini-player-card",
      "description": "Cyber-Glass card with the record half outside its left edge.",
      "html": "<div class=\"ds-mini\"><div class=\"ds-mdisc\"></div><div class=\"ds-mcard\"><span class=\"ds-dev\">PHONE SPEAKER</span><b>9 - Calinacho</b><small>LIVE SPECTRAL EQ</small><div class=\"ds-mbar\"><span></span></div></div></div>",
      "css": ".ds-mini{position:relative;width:340px;padding-left:48px;font-family:Roboto,sans-serif}.ds-mcard{border-radius:28px;background:rgba(17,24,39,.92);border:1px solid #8B5CF6;box-shadow:0 10px 30px rgba(139,92,246,.35);padding:12px 14px 14px 60px;color:#fff;display:flex;flex-direction:column;gap:4px}.ds-dev{align-self:flex-start;background:#162A3A;color:#E2E8F0;border-radius:999px;padding:4px 12px;font-size:11.5px;letter-spacing:.6px}.ds-mcard b{font-size:18px}.ds-mcard small{color:rgba(0,229,255,.78);font-size:10.5px;letter-spacing:.9px;font-weight:600}.ds-mbar{height:4px;border-radius:2px;background:rgba(56,189,248,.12);margin-top:8px}.ds-mbar span{display:block;width:35%;height:100%;border-radius:2px;background:linear-gradient(90deg,#8B5CF6,#00E5FF,#00F5D4)}.ds-mdisc{position:absolute;left:0;top:50%;width:96px;height:96px;margin-top:-48px;border-radius:50%;background:#0D0D10;border:2px solid #00E5FF;box-shadow:0 0 18px rgba(139,92,246,.5)}.ds-mcard:focus-within{outline:2px solid #00E5FF}"
    },
    {
      "name": "Queue Row",
      "kind": "custom",
      "refersTo": "queue-row",
      "description": "48dp handle, 42dp cover, title/artist, 48dp remove.",
      "html": "<div class=\"ds-qrow\"><span class=\"ds-h\">=</span><span class=\"ds-art\"></span><span class=\"ds-t\"><b>Slow Weather</b><small>The Paper Coast · 3:13</small></span><button aria-label=\"Remove\">✕</button></div>",
      "css": ".ds-qrow{display:flex;align-items:center;font-family:Roboto,sans-serif;background:transparent;border-radius:12px;padding-right:4px}.ds-qrow:hover{background:#E8E4FD}.ds-h{width:48px;text-align:center;color:#5D5878;font-size:20px}.ds-art{width:42px;height:42px;border-radius:8px;background:linear-gradient(#7B6CF0,#3A2A8C)}.ds-t{flex:1;display:flex;flex-direction:column;margin-left:12px}.ds-t b{font-size:14.5px;color:#17142B;font-weight:600}.ds-t small{font-size:12px;color:#5D5878}.ds-qrow button{width:48px;height:48px;border:0;background:none;color:#5D5878;cursor:pointer}.ds-qrow button:focus-visible{outline:2px solid #6C4BE8}"
    },
    {
      "name": "Glass Nav Pill",
      "kind": "nav",
      "refersTo": "glass-card-dark",
      "description": "Floating frosted capsule with the selected destination in a smaller capsule.",
      "html": "<nav class=\"ds-nav\"><a class=\"on\">Home</a><a>Library</a><a>Playlists</a><a>Discover</a><a>Downloads</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;padding:6px;border-radius:999px;background:rgba(19,27,46,.9);border:1px solid rgba(56,189,248,.25);font:500 12px Roboto,sans-serif}.ds-nav a{padding:10px 12px;border-radius:999px;color:#94A3B8;cursor:pointer}.ds-nav a.on{color:#00E5FF;background:rgba(0,229,255,.12)}.ds-nav a:hover{color:#E2E8F0}.ds-nav a:focus-visible{outline:2px solid #00E5FF}"
    },
    {
      "name": "Editorial Card",
      "kind": "card",
      "refersTo": "editorial-card",
      "description": "Hairline-outlined card, fill = field.",
      "html": "<div class=\"ds-ecard\"><b>Crossfade</b><small>4 s</small></div>",
      "css": ".ds-ecard{border-radius:18px;background:#F4FDFF;border:1px solid rgba(22,35,43,.16);padding:14px 16px;font-family:Roboto,sans-serif;display:flex;flex-direction:column}.ds-ecard b{color:#16232B;font-size:16px}.ds-ecard small{color:rgba(22,35,43,.6)}.ds-ecard:hover{border-color:#F3A311}"
    }
  ],
  "narrative": {
    "northStar": "The Listening Room",
    "overview": "Harmony is a quiet room where one object matters: the record. On Now Playing the sleeve sits on a soft lavender (dark: aubergine-black) field with the disc drawn halfway out, turning while the music plays. Everything else on that screen is low-contrast and tonal, so the eye goes to the record, then the title, then the one white play button. Around the room is the hi-fi gear: the Cyber-Glass mini player and navigation pill, glass panels with cyan and violet neon rims, and the Library in obsidian (dark) or pearl (light) glass. The pages you pass through (Home, playlists, Settings, Equalizer, Discover) are calm Editorial pages on one shared field, where each section says who it is with a single accent colour.\n\nThese three looks coexist on purpose, and the code says so in comments: the player owns its palette and opts out of Material dynamic colour [code: `PlayerLook.kt`]; Cyber-Glass \"dresses the library, the floating mini player and the navigation pill, in both themes\" [code: `CyberGlassColors.kt`]; Editorial pages share one field and colour only their controls [code: `EditorialLook.kt`]. The record is the thread through all three: the full sleeve-and-disc on Now Playing, a spinning round disc on the mini player, and a static sleeve-and-disc on album grids (`VinylAlbumCover`).\n\nDensity is relaxed on the player and the mini player, denser in the Queue (a list you reorder, not browse). Motion is physical and continuous: the record coasts to a stop instead of snapping, drags follow the finger, and every gesture has a visible \"not far enough, spring back\" state.",
    "keyCharacteristics": [
      "One hero per screen; on Now Playing it is always the record.",
      "The player palette ignores wallpaper colours but follows light/dark/AMOLED.",
      "The record is a dark object in both themes.",
      "Neon and glow belong to the chrome (mini player, nav, Library, Downloads), never to the player field.",
      "Section identity lives in one accent, not in a coloured background.",
      "No brand font on Android: Roboto, with hand-set sizes."
    ],
    "rules": [
      {
        "name": "The Player Owns Its Light Rule",
        "body": "Now Playing, the Queue sheet and the Smart Shuffle sheet use `playerPalette()` only. Material dynamic colour never repaints them; light/dark/AMOLED still apply.",
        "section": "colors"
      },
      {
        "name": "The Dark Record Rule",
        "body": "The record (`VinylArtwork`, the mini player `Disc`, `VinylDisc`, `VinylAlbumCover`) is near-black in both themes. A coverless mini-player record gets a dark label in light mode too.",
        "section": "colors"
      },
      {
        "name": "The One Coloured Thing Rule",
        "body": "On the player field, colour means state: if it is violet, it is on, played, or the current track.",
        "section": "colors"
      },
      {
        "name": "The Hand-Set Scale Rule",
        "body": "Sizes are set per component in `sp`, not taken from Material type roles (except `bodyMedium`, `titleSmall`, `bodyLarge`). Everything is in `sp`, so it follows the system font size.",
        "section": "typography"
      },
      {
        "name": "The Quiet Field Rule",
        "body": "On the player, depth is one shadow (the sleeve) plus tonal circles with hairlines. No glows, no glass, no gradients on the player field.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the record as Now Playing's centre in both orientations: sleeve at 70% of the block, record the same size peeking right, 9 s turn, 18dp tuck, 0.97 breathe, swipe-to-skip on the record.",
      "**Do** change the record block's size and vertical position when a phone is short, so the title, waveform and transport stay fully on screen.",
      "**Do** use `playerPalette()` for anything that opens over Now Playing.",
      "**Do** keep the record near-black in light and dark.",
      "**Do** use violet on the player only for state (on, played, current).",
      "**Do** keep Cyber-Glass neon to the chrome, Library and Downloads, with `Glow` softened on pearl.",
      "**Do** give every Editorial section one accent and leave the field neutral.",
      "**Do** keep the mini player and Now Playing reporting the same audio format (shared resolver)."
    ],
    "donts": [
      "**Don't** remove, hide, or flatten the Now Playing record, or put it behind a setting.",
      "**Don't** let Material dynamic colour reach the player field or its sheets' content.",
      "**Don't** add glows, glass or gradients to the Now Playing field.",
      "**Don't** make a page-wide horizontal gesture on Now Playing; it would fight the seek bar.",
      "**Don't** colour an Editorial page's background with its section accent; that was tried and removed.",
      "**Don't** fix the player's height by hard-coding a smaller record for everyone; the 411dp-and-up phones fit today."
    ]
  }
}