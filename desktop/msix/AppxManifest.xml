<?xml version="1.0" encoding="utf-8"?>
<!--
  Harmony for Windows as an MSIX package, for the Microsoft Store. The Store
  signs the package itself, so it installs without any SmartScreen warning.
  @IDENTITY_NAME@, @PUBLISHER@, @PUBLISHER_DISPLAY_NAME@ and @VERSION@ are
  filled in by .github/workflows/desktop.yml (see store-identity.properties).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  IgnorableNamespaces="uap rescap desktop2">

  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Harmony</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Your music, and your phone's music, on this PC.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Harmony Connect: phones on the home network find this PC and send it music. -->
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="Harmony" Executable="Harmony.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Harmony"
        Description="Your music, and your phone's music, on this PC."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Extensions>
    <!--
      Opens Harmony Connect's ports on home and work networks when the app is
      installed, so Windows never has to ask: TCP 47800 (the phone sends music
      and commands) and UDP 47801 (the phone looks for this PC).
    -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="Harmony.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="domainAndPrivate" LocalPortMin="47800" LocalPortMax="47800" />
        <desktop2:Rule Direction="in" IPProtocol="UDP" Profile="domainAndPrivate" LocalPortMin="47801" LocalPortMax="47801" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>
</Package>
